# Canonical origin. No trailing slash. www and *.up.railway.app are published as this host.
NEXT_PUBLIC_SITE_URL=https://designcodejobs.com

# Supabase Postgres (server only — never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/ingest and /api/indexnow. Send `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Optional. Owner page at /review for low-confidence matches.
REVIEW_SECRET=

# Lemon Squeezy. Create two products: Standard ($129) and Featured ($228).
# Paste each variant's hosted checkout URL. The app appends the submission id.
LEMONSQUEEZY_CHECKOUT_STANDARD_URL=
LEMONSQUEEZY_CHECKOUT_FEATURED_URL=
# Optional variant ids. When set, the webhook only publishes a matching variant.
LEMONSQUEEZY_VARIANT_STANDARD=
LEMONSQUEEZY_VARIANT_FEATURED=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Optional Google Indexing API service account JSON, as a single line.
# URL_UPDATED on publish, URL_DELETED when a job closes. Leave empty to no-op.
GOOGLE_INDEXING_CREDENTIALS=

# How many company boards one cron invocation pulls before saving the cursor.
INGEST_BATCH=20

# IndexNow key. Public: it is served at https://designcodejobs.com/<key>.txt
# 8–128 characters, a-z A-Z 0-9 and dashes. Empty disables submissions.
INDEXNOW_KEY=10bf5cfa82ac960b7a1d23c83bbf60ab
